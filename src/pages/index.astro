---
import Layout from '~/layouts/LandingLayout.astro';

import Header from '~/components/widgets/Header.astro';
import Hero2 from '~/components/widgets/Hero2.astro';
import Features from '~/components/widgets/Features.astro';
import Steps2 from '~/components/widgets/Steps2.astro';
import Content from '~/components/widgets/Content.astro';
import Pricing from '~/components/widgets/Pricing.astro';

import { headerData } from '~/navigation';
import FAQs from '~/components/widgets/FAQs.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';

const metadata = {
  title: 'Sponsura - Community Sponsorship Management',
};
---

<Layout metadata={metadata}>
  <Fragment slot="header">
    <Header
      links={[
        { text: 'Features', href: '#features' },
        { text: 'Use Cases', href: '#use-cases' },
        { text: 'Pricing', href: '#pricing' },
        { text: 'FAQ', href: '#faq' },
        { text: 'Contact', href: '#contact' },
      ]}
      actions={[
        {
          text: 'Login',
          href: '#',
          variant: 'secondary'
        },
        {
          text: 'Start Free',
          href: '#',
          variant: 'primary'
        },
      ]}
      isSticky
    />
  </Fragment>

  <!-- Hero2 Widget ******************* -->

  <Hero2
    tagline="Community Sponsorship Management"
    actions={[
      { variant: 'primary', target: '_blank', text: 'Start Free', href: '' },
      { text: 'Schedule a Demo', href: '' },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1580481072645-022f9a6dbf27?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=2070&q=80',
      alt: 'AstroWind Hero Image',
    }}
  >
    <Fragment slot="title">
    Stop guessing and start proving community impact
    </Fragment>

    <Fragment slot="subtitle">
      Stop writing checks and hoping for results. Sponsura gives you one place to manage sponsorships, collect proof from partners, and clearly show the impact of every community investment.
    </Fragment>
  </Hero2>

  <!-- Features Widget *************** -->

  <Features
    id="features"
    title="Everything you need to run sponsorships"
    subtitle="Sponsura brings every part of your community sponsorship program into one clear, accountable system — from request to proof."
    columns={2}
    items={[
      {
        title: 'One system for every sponsorship',
        description:
          'Keep requests, budgets, partners, deliverables, and activations in one organized place so nothing gets lost across spreadsheets, inboxes, or shared drives.',
        icon: 'tabler:database',
      },
      {
        title: 'Clear deliverables and expectations',
        description:
          'Define exactly what each partner is responsible for — from signage to posts to appearances — so every sponsorship has structure, even when it is unique.',
        icon: 'tabler:checklist',
      },
      {
        title: 'Built-in partner proof collection',
        description:
          'Partners upload photos, links, and files directly into Sponsura, eliminating email chasing and ensuring every deliverable has evidence attached.',
        icon: 'tabler:upload',
      },
      {
        title: 'Proof of impact, not just spend',
        description:
          'Connect every dollar to what was actually delivered, giving leadership clear, defensible proof that sponsorships produced real community impact.',
        icon: 'tabler:chart-bar',
      },
      {
        title: 'Real-time status and accountability',
        description:
          'See which deliverables are pending, submitted, approved, or missing so you always know which partners are on track and which need attention.',
        icon: 'tabler:progress',
      },
      {
        title: 'Impact-ready reporting',
        description:
          'Generate clean reports by sponsorship, partner, or time period that show what was promised, what was delivered, and how your program is performing.',
        icon: 'tabler:report',
      }
    ]}
  />

  <!-- Content Widget **************** -->

  <Content
    id="use-cases"
    title="Use Cases"
    subtitle="Whether you are running a handful of local partnerships or a growing portfolio of community investments, Sponsura adapts to how sponsorships are really managed."
    isReversed
    items={[
      {
        title: 'Description: ',
        description:
          'Sponsorships live in spreadsheets, inboxes, and shared drives, making it hard to know what is active, what is due, and what has already happened.',
      },
      {
        title: 'Benefits',
        description: `Centralize all sponsorships, partners, and deliverables in one system.  Keep timelines and expectations clear.  Reduce errors and missed commitments.  Always know the status of every sponsorship.`,
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1620558138198-cfb9b4f3c294?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=1671&q=80',
      alt: 'Startup Image',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-xl mb-2">
        Managing Active Sponsorships:<br /><span class="text-3xl">Keep every partnership on track</span>
      </h3>
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Content Widget **************** -->

  <Content
    isAfterContent={true}
    items={[
      {
        title: 'Problem:',
        description: `Teams waste time chasing partners for photos, links, and proof that sponsorships were delivered.`,
      },
      {
        title: 'Solution:',
        description: `Let partners upload evidence directly.  Automatically attach proof to the right deliverable.  Eliminate email follow-ups.  Keep everything organized and reviewable.`,
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1531973486364-5fa64260d75b?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=1658&q=80',
      alt: 'SaaS Businesses Image',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-xl mb-2">
        Partnership Proof Collection:<br /><span class="text-3xl">Make evidence easy to get</span>
      </h3>
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Content Widget **************** -->

  <Content
    isReversed
    isAfterContent={true}
    items={[
      {
        title: 'Problem:',
        description: `Leadership sees money spent, but not what it produced, making sponsorships hard to defend.`,
      },
      {
        title: 'Solution:',
        description: `Connect every sponsorship to real proof.  Show what was promised and delivered.  Provide tangible evidence of impact.  Build trust with leadership.`,
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1635070041078-e363dbe005cb?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=2070&q=80',
      alt: 'Portfolio Image',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-xl mb-2">
        Proving Sponsorship Impact:<br /><span class="text-3xl">Show what your spend delivered</span>
      </h3>
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Content Widget **************** -->

  <Content
    items={[
      {
        title: 'Problem:',
        description: `As programs grow, so does the manual work, increasing mistakes and slowing teams down.`,
      },
      {
        title: 'Solution:',
        description: `Use built-in workflows and structure.  Keep partners accountable at scale.  Reduce admin as you grow.  Run more sponsorships with the same team.`,
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1514621166532-aa7eb1a3a2f4?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=774&q=80',
      alt: 'Small Business Image',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-xl mb-2">
        Scaling community programs: <br /><span class="text-3xl">Grow without the chaos</span>
      </h3>
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Pricing Widget ******************* -->

  <Pricing
    id="pricing"
    title="Pricing that scales with your sponsorships"
    prices={[
      {
        title: 'free',
        subtitle: 'Manage up to two active community sponsorships.',
        price: '0',
        period: '/ month',
        items: [
          {
            description: 'Up to 2 active sponsorships',
          },
          {
            description: 'Deliverables & timelines',
          },
          {
            description: 'Partner evidence uploads',
          },
          {
            description: 'Proof & status tracking',
          },
          {
            description: 'Basic reporting',
          },
        ],
        callToAction: {
          target: '_blank',
          text: 'Start Free',
          href: '#',
        },
      },
      {
        title: 'Basic',
        subtitle: 'Collect requests and manage unlimited sponsors.',
        price: 45,
        period: '/ Month',
        items: [
          {
            description: 'Unlimited sponsorships',
          },
          {
            description: 'Sponsorship request forms',
          },
          {
            description: 'Budgets & partner records',
          },
          {
            description: 'Deliverables & proof',
          },
          {
            description: 'Standard reporting',
          },
        ],
        callToAction: {
          target: '_blank',
          text: 'Get Started',
          href: '#',
        },
        hasRibbon: true,
        ribbonTitle: 'popular',
      },
      {
        title: 'Team',
        subtitle: 'Work with teammates to manage sponsorships.',
        price: 149,
        period: '/ Month',
        items: [
          {
            description: 'Everything in Basic',
          },
          {
            description: 'Multiple users',
          },
          {
            description: 'Roles & permissions',
          },
          {
            description: 'Team workflows',
          },
          {
            description: 'Shared reporting',
          },
        ],
        callToAction: {
          target: '_blank',
          text: 'Start a Team',
          href: '#',
        },
      },
      {
        title: 'Enterprise',
        subtitle: 'Advanced security for regulated organizations.',
        price: '500+',
        period: '/ Month',
        items: [
          {
            description: 'Everything in Team',
          },
          {
            description: 'Single sign-on (SSO)',
          },
          {
            description: 'Advanced access controls',
          },
          {
            description: 'Audit logs',
          },
          {
            description: 'Dedicated support',
          },
        ],
        callToAction: {
          target: '_blank',
          text: 'Talk to Sales',
          href: '#',
        },
      },
    ]}
  />

  <!-- FAQs Widget ******************* -->

  <FAQs
    id="faq"
    title="Frequently Asked Questions"
    items={[
  {
    title: 'What is Sponsura?',
    description:
      'Sponsura is a community sponsorship management platform that helps teams run, track, and prove their sponsorships in one place, replacing spreadsheets, email, and guesswork with clear accountability.',
    icon: 'tabler:chevrons-right',
  },
  {
    title: 'Who is Sponsura built for?',
    description:
      'Sponsura is designed for community-focused brands and marketing teams that manage local sponsorships, partnerships, and activations and need a better way to organize, track, and prove their impact.',
    icon: 'tabler:chevrons-right',
  },
  {
    title: 'How does Sponsura help prove sponsorship impact?',
    description:
      'Sponsura connects every sponsorship to deliverables and partner-submitted proof like photos, files, and links, making it easy to show what was promised, what was delivered, and what your investment produced.',
    icon: 'tabler:chevrons-right',
  },
  {
    title: 'Can I try Sponsura before paying?',
    description:
      'Yes, you can start for free and manage up to two active sponsorships with no credit card required, giving you a simple way to see how Sponsura works before upgrading.',
    icon: 'tabler:chevrons-right',
  },
]}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </FAQs>

  <!-- Steps2 Widget ****************** -->

  <Steps2
    id="contact"
    title="Reach out to us"
    subtitle="Have questions? Send a note and we’ll point you in the right direction."
    callToAction={{
      text: 'Contact us',
      href: '/',
    }}
    items={[
      {
        title: 'Email support',
        description: 'support@sponsorshipassurance.com',
        icon: 'tabler:mail',
      },
      {
        title: 'Schedule a demo',
        description: 'Want a walkthrough? Pick a time and we’ll show you Sponsura live.',
        icon: 'tabler:calendar-event',
      },
      {
        title: 'In-app chat',
        description: 'Chat with us directly inside Sponsura for quick questions and help.',
        icon: 'tabler:message-circle',
      },
    ]}
  />

  <!-- BlogLatestPost Widget **************** -->

  <BlogLatestPosts
    id="blog"
    title="Stay informed with AstroWind's blog"
    information={`Explore our collection of articles, guides, and tutorials on web development, design trends, and using AstroWind effectively for your projects.`}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </BlogLatestPosts>
</Layout>
